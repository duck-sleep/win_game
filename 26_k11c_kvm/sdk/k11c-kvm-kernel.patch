@@ -281,3 +281,10 @@ &rknpu_mmu {
 &vp0 {
 	cursor-win-id = <ROCKCHIP_VOP2_CLUSTER0>;
 };
+
+/* Type-C 固定当 device：本板 CC/ID 没接角色控制器，全 DTB 里既没有 usb-role-switch
+   也没有 extcon，默认 "otg" 只能靠 ID/VBUS 猜角色，UDC 会不会出现不确定。
+   KVM 要求板子永远是被控机的外设，所以直接写死。见 14_K11C做JetKVM式IP-KVM_方案.md §2-Q2 */
+&usbdrd_dwc3 {
+	dr_mode = "peripheral";
+};
