<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#10151d">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待机 —— 开始捕获后偷听系统声"
            android:textColor="#ffffff"
            android:textSize="18sp" />

        <com.meig.hapticx.SpectrumView
            android:id="@+id/spectrum"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/motors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="左马达 0%  ｜  右马达 0%"
                android:textColor="#44d62c"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/beat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEAT"
                android:textColor="#3d4f6b"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/barL"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#44d62c" />
        <ProgressBar
            android:id="@+id/barR"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#29c7d6" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/tone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="重新打开悬浮马达条" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="捕获后会在游戏上层浮一条左右马达。也可：最近任务 → 雷云图标 → 分屏，再点游戏。"
            android:textColor="#9aa3b0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="模式"
            android:textColor="#9aa3b0"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="频段增益 30–200Hz（0–200%）"
            android:textColor="#9aa3b0"
            android:textSize="14sp" />

        <TextView android:id="@+id/lab0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#44d62c" android:textSize="13sp" android:layout_marginTop="6dp" android:text="超低音 100%" />
        <SeekBar android:id="@+id/gain0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="200" android:progress="100" />
        <TextView android:id="@+id/lab1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#29c7d6" android:textSize="13sp" android:text="低音 70%" />
        <SeekBar android:id="@+id/gain1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="200" android:progress="70" />
        <TextView android:id="@+id/lab2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8a9bf0" android:textSize="13sp" android:text="中低音 30%" />
        <SeekBar android:id="@+id/gain2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="200" android:progress="30" />

        <Button
            android:id="@+id/resetGains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="恢复本档默认增益" />
    </LinearLayout>
</ScrollView>
