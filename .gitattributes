# 板子上跑的一律 LF：这些文件会被 scp 到 Ubuntu 直接执行，CRLF 会让 #!/bin/sh 那行失效
26_k11c_kvm/**/*.sh text eol=lf
26_k11c_kvm/**/*.py text eol=lf
26_k11c_kvm/**/*.service text eol=lf
26_k11c_kvm/**/*.desktop text eol=lf
26_k11c_kvm/**/*.html text eol=lf
# 网关源码要 scp 到 VM 上编译，同样锁 LF
26_k11c_kvm/**/*.go text eol=lf
26_k11c_kvm/**/go.mod text eol=lf
26_k11c_kvm/**/go.sum text eol=lf

# 所有 shell 脚本一律 LF：CRLF 会让 #!/bin/sh 那行带 ，脚本直接跑不动
*.sh text eol=lf
