+#define skw_foreach_element(_elem, _data, _datalen)			     \
+	for (_elem = (struct skw_element *)(_data);                          \
+	     (const u8 *)(_data) + (_datalen) - (const u8 *)_elem >=	     \
+		(int)sizeof(*_elem) &&					     \
+	     (const u8 *)(_data) + (_datalen) - (const u8 *)_elem >=	     \
+		(int)sizeof(*_elem) + _elem->datalen;			     \
+	     _elem = (struct skw_element *)(_elem->data + _elem->datalen))
