+#endif
+	phydm_write_dig_reg(dm, new_igi);
+
+	PHYDM_DBG(dm, DBG_DIG, "New %s-IGI=((0x%x))\n",
+		  (dig_t->tdma_dig_state == TDMA_DIG_LOW_STATE) ? "L" : "H",
+		  new_igi);
+}
