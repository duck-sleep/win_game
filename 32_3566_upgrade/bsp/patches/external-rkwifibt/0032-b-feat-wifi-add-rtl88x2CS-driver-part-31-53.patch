+static u8 phydm_sq_patch_rt_cid_819x_acer(
+	struct dm_struct *dm,
+	u8 is_cck_rate,
+	u8 pwdb_all,
+	u8 path,
+	u8 RSSI)
+{
+	u8 sq = 0;
+
+	if (is_cck_rate) {
+#if OS_WIN_FROM_WIN8(OS_VERSION)
+		if (pwdb_all >= 50)
+			sq = 100;
+		else if (pwdb_all >= 35 && pwdb_all < 50)
+			sq = 80;
