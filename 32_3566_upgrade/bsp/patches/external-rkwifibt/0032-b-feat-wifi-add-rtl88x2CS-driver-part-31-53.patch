+	phy_info->recv_signal_power = rx_pwr_db_max;
+	phy_info->is_beamformed = false;
+	phy_info->is_mu_packet = false;
+	phy_info->rx_pwdb_all = phydm_pw_2_percent(rx_pwr_db_max);
