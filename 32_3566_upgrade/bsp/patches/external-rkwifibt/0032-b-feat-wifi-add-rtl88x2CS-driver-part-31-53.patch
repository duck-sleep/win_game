+	odm_move_memory(dm, dbg_i->snr_hist_th, snr_hist_th, size);
+	odm_move_memory(dm, dbg_i->evm_hist_th, evm_hist_th, size);
+	#ifdef PHYDM_PHYSTAUS_AUTO_SWITCH
+	dm->pkt_proc_struct.physts_auto_swch_en = false;
