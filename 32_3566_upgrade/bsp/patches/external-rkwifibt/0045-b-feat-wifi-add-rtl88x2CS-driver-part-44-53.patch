+				#define MAX_RECVBUF_SZ (8192) /* 8K */
+			#else
+				#define MAX_RECVBUF_SZ (15360) /* 15k < 16k */
+			#endif
+			/* #define MAX_RECVBUF_SZ (8192+1024) */ /* 8K+1k */
