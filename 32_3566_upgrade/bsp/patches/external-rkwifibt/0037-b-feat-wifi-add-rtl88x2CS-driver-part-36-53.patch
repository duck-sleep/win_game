+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		/*CCK*/
+		ref_pow_tmp = ref_pow_cck[path];
+		for (j = ODM_RATE1M; j <= ODM_RATE11M; j++) {
