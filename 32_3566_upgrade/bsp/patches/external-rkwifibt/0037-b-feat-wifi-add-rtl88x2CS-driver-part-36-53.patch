+	pr_debug("ref_pow_cck={%d, %d}, ref_pow_ofdm={%d, %d}\n",
+		 ref_pow_cck[0], ref_pow_cck[1], ref_pow_ofdm[0],
+		 ref_pow_ofdm[1]);
