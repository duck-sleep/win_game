+		pr_debug("[A][rate:%d] = %d\n", i, diff_tab[RF_PATH_A][i]);
+	pr_debug("2. diff_tab path B\n");
+	for (i = 0; i <= ODM_RATEVHTSS2MCS9; i++)
+		pr_debug("[B][rate:%d] = %d\n", i, diff_tab[RF_PATH_B][i]);
