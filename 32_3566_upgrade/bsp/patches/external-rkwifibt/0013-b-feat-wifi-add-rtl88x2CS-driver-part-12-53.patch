+u8 MRateToHwRate(enum MGN_RATE rate)
+{
+	u8 hw_rate = DESC_RATE1M; /* default value, also is zero */
+
+	if (rate < MGN_UNKNOWN)
+		hw_rate = _MRateToHwRate[rate];
+
+	if (rate != MGN_1M && hw_rate == DESC_RATE1M)
+		RTW_WARN("Invalid rate 0x%x in %s\n", rate, __FUNCTION__);
+
+	return hw_rate;
+}
