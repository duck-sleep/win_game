+	hal_data->init_reg_0x428 = rtw_read16(adapter, 0x428);
+	hal_data->init_reg_0x514 = rtw_read32(adapter, 0x514);
+	hal_data->init_reg_0x63a = rtw_read16(adapter, 0x63a);
+	hal_data->init_reg_0x63c = rtw_read32(adapter, 0x63c);
