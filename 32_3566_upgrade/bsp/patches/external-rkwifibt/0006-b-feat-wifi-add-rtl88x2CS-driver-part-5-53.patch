+void rm_set_rep_mode(struct rm_obj *prm, u8 mode)
+{
+
+	RTW_INFO("RM: rmid=%x set %s\n",
+		prm->rmid,
+		mode&MEAS_REP_MOD_INCAP?"INCAP":
+		mode&MEAS_REP_MOD_REFUSE?"REFUSE":
+		mode&MEAS_REP_MOD_LATE?"LATE":"");
+
+	prm->p.m_mode |= mode;
+}
