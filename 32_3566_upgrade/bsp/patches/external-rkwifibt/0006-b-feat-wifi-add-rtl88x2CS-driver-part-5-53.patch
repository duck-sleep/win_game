+
+	if (opch > cch)
+		offset = CHAN_OFFSET_LOWER;
+	else if (opch < cch)
+		offset = CHAN_OFFSET_UPPER;
+
+	return rtw_get_scch_by_cch_offset(cch, bw, offset);
+}
+#endif
