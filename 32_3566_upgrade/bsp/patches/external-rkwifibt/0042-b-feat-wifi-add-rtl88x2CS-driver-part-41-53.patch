+static u8 hw_var_get_bcn_valid(PADAPTER adapter)
+{
+	u8 val8 = 0;
+	u8 ret = _FALSE;
+
+	/* only port 0 can TX BCN */
+	val8 = rtw_read8(adapter, REG_FIFOPAGE_CTRL_2_8822C + 1);
+	ret = (BIT(7) & val8) ? _TRUE : _FALSE;
+
+	return ret;
+}
