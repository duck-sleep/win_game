+static void hw_var_set_ack_preamble(PADAPTER adapter, u8 bShortPreamble)
+{
+	u8 val8 = 0;
+
+
+	val8 = rtw_read8(adapter, REG_WMAC_TRXPTCL_CTL_8822C + 2);
+	val8 |= BIT(4) | BIT(5);
+
+	if (bShortPreamble)
+		val8 |= BIT1;
+	else
+		val8 &= (~BIT1);
+
+	rtw_write8(adapter, REG_WMAC_TRXPTCL_CTL_8822C + 2, val8);
+}
