+	if (!config_phydm_read_rf_check_8822c(val))
+		RTW_INFO(FUNC_ADPT_FMT ": read RF reg path=%d addr=0x%x mask=0x%x FAIL!\n",
+			 FUNC_ADPT_ARG(adapter), path, addr, mask);
+
+	return val;
+}
