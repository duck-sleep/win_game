+static void hw_var_set_bcn_valid(PADAPTER adapter)
+{
+	u8 val8 = 0;
+
+	/* only port 0 can TX BCN */
+	val8 = rtw_read8(adapter, REG_FIFOPAGE_CTRL_2_8822C + 1);
+	val8 = val8 | BIT(7);
+	rtw_write8(adapter, REG_FIFOPAGE_CTRL_2_8822C + 1, val8);
+}
