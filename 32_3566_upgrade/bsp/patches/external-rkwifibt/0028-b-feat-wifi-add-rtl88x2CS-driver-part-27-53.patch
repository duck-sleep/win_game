+/* Swap Little-endian <-> Big-endia*/
+#define SWAP32(x)                                                              \
+	((u32)((((u32)(x) & (u32)0x000000ff) << 24) |                          \
+	       (((u32)(x) & (u32)0x0000ff00) << 8) |                           \
+	       (((u32)(x) & (u32)0x00ff0000) >> 8) |                           \
+	       (((u32)(x) & (u32)0xff000000) >> 24)))
+
+#define SWAP16(x)                                                              \
+	((u16)((((u16)(x) & (u16)0x00ff) << 8) |                               \
+	       (((u16)(x) & (u16)0xff00) >> 8)))
+
+/*1->Little endian 0->Big endian*/
+#if HALMAC_SYSTEM_ENDIAN
