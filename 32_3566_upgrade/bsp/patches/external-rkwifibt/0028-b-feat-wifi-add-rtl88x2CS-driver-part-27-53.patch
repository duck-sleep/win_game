+#define rtk_cpu_to_le32(x)              ((u32)(x))
+#define rtk_le32_to_cpu(x)              ((u32)(x))
+#define rtk_cpu_to_le16(x)              ((u16)(x))
+#define rtk_le16_to_cpu(x)              ((u16)(x))
+#define rtk_cpu_to_be32(x)              SWAP32((x))
