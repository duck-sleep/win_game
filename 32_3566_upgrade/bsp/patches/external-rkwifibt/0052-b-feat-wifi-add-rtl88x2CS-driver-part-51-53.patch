+int rtw_nlrtw_reg_beacon_hint_event(_adapter *adapter)
+{
+	struct sk_buff *skb = NULL;
+	void *msg_header = NULL;
+	struct wiphy *wiphy;
+	u8 i;
+	int ret;
+
+	wiphy = adapter_to_wiphy(adapter);
