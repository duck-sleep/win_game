+	if (dm->support_ic_type & (ODM_RTL8735B)) {
+		if (path > RF_PATH_A) {
+			PHYDM_DBG(dm, ODM_PHY_CONFIG, "Unsupported path (%d)\n",
+				  path);
+			return false;
+		}
+		txagc_cck = (u8)odm_get_bb_reg(dm, r_new_txagc[path],
+					       0x0000007f);
+		txagc_ofdm = (u8)odm_get_bb_reg(dm, r_new_txagc[path],
