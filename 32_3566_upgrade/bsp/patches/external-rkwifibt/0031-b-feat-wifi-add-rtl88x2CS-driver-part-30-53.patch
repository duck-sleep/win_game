+#if USE_WORKITEM
+	odm_schedule_work_item(&dm->fast_ant_training_workitem);
+#else
+	PHYDM_DBG(dm, DBG_ANT_DIV, "******%s******\n", __func__);
+	odm_fast_ant_training(dm);
+#endif
+}
