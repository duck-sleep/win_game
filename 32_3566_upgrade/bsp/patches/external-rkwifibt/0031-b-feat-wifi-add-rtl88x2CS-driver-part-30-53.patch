+				return false;
+
+			txagc_cck -= pwr_offset;
+			txagc_ofdm -= pwr_offset;
+		}
+		#if (RTL8730A_SUPPORT)
+		ret = config_phydm_write_txagc_ref_8730a(dm, (u8)txagc_cck,
+							 path, PDM_CCK);
