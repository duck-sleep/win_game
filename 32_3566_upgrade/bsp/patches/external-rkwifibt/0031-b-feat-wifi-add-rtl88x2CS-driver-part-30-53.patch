+	fat_tab->aux_sum[macid] = 0;
+	fat_tab->main_cnt[macid] = 0;
+	fat_tab->aux_cnt[macid] = 0;
+	fat_tab->main_sum_cck[macid] = 0;
+	fat_tab->aux_sum_cck[macid] = 0;
+	fat_tab->main_cnt_cck[macid] = 0;
+	fat_tab->aux_cnt_cck[macid] = 0;
+}
