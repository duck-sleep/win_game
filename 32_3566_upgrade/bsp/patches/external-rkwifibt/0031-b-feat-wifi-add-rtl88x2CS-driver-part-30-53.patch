+
+	} else {
+		fat_tab->aux_evm_2ss_sum[id][0] += (phy_info->rx_mimo_evm_dbm[0]
+						   << 5);
+		fat_tab->aux_evm_2ss_sum[id][1] += (phy_info->rx_mimo_evm_dbm[1]
+						   << 5);
+		fat_tab->aux_evm_2ss_cnt[id]++;
+	}
+}
