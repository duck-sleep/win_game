+	CL_SPRINTF(cli_buf, BT_TMP_BUF_SIZE, "\r\n %-35s = %d/ %d/ %s/ %d",
+		   "WL_TxPw/BT_TxPw/WL_Rx/BT_LNA_Lvl",
