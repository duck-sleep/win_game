+
+	static const u32	wl_rx_gain_off_HT40[] = {0xff000003,
+		0xf4120003, 0xf5100003, 0xf60e0003, 0xf70c0003, 0xf80a0003,
+		0xf3140003, 0xf2160003, 0xf1180003, 0xf01a0003, 0xef1c0003,
