+	}
+
+	if (coex_sta->bt_slave && coex_sta->wl_gl_busy)
+		rtw_btc_set_bt_golden_rx_range(btc, NM_EXCU, 3, 20);
+	else
+		rtw_btc_set_bt_golden_rx_range(btc, NM_EXCU, 3, 0);
