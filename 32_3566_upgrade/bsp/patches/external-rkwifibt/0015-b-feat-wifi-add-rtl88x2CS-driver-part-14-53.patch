+
+	u32		*wl_rx_gain_on, *wl_rx_gain_off;
+
+	if (coex_dm->cur_wl_rx_low_gain_en) {
+		BTC_SPRINTF(trace_buf, BT_TMP_BUF_SIZE,
+			    "[BTCoex], Hi-Li Table On!\n");
