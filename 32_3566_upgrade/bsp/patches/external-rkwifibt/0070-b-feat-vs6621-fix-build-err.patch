 drivers/skw6621s/swt6621s_wifi/skw_vendor.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/skw6621s/swt6621s_wifi/skw_vendor.c b/drivers/skw6621s/swt6621s_wifi/skw_vendor.c
index b52877e..672b1f5 100755
--- a/drivers/skw6621s/swt6621s_wifi/skw_vendor.c
+++ b/drivers/skw6621s/swt6621s_wifi/skw_vendor.c
@@ -266,12 +266,13 @@ static int skw_vendor_get_usable_channels(struct wiphy *wiphy,
 	enum nl80211_band band;
 	struct skw_usable_chan *chans;
 	struct skw_usable_chan_req *req = (struct skw_usable_chan_req *)data;
+	size_t size_chans;
 
 	skw_dbg("band_mask: 0x%x\n", req->band_mask);
 
 	max = ieee80211_get_num_supported_channels(wiphy);
-
-	chans = SKW_ZALLOC(max * sizeof(*chans), GFP_KERNEL);
+	size_chans = max * sizeof(*chans);
+	chans = SKW_ZALLOC(size_chans, GFP_KERNEL);
 	if (!chans)
 		return -ENOMEM;
 
