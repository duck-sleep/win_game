+	struct lmt_reg *ent = hal_txpwr_lmt_reg_get_by_name(hal_data, name);
+
+	if (ent) {
+		if (band == BAND_ON_24G && ent->lmt_2g)
+			return true;
+		#if CONFIG_IEEE80211_BAND_5GHZ
+		if (band == BAND_ON_5G && ent->lmt_5g)
+			return true;
+		#endif
+	}
+	return false;
