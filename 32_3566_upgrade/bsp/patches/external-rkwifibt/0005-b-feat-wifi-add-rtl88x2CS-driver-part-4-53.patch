+				ARRAY_SIZE(store->stack_entries), 1);
+}
+#else /* !CONFIG_ARCH_STACKWALK */
+static inline void stacktrace_print(const struct mem_entry *entries,
+				    unsigned int nr_entries, int spaces)
+{
