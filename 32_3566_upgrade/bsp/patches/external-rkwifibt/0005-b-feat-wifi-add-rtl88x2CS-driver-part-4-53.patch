+module_param(rtkm_mem_exp, bool, 0644);
+MODULE_PARM_DESC(rtkm_mem_exp, "Preallocated memory expansion");
+
+#ifndef RTKM_MPOOL_0
+#define RTKM_MPOOL_0 0
+#endif
+#ifndef RTKM_MPOOL_1
+#define RTKM_MPOOL_1 0
