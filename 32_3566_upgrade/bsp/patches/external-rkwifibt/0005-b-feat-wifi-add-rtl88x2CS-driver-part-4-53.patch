+#ifndef RTKM_MPOOL_2
+#define RTKM_MPOOL_2 0
+#endif
+#ifndef RTKM_MPOOL_3
+#define RTKM_MPOOL_3 0
+#endif
+#ifndef RTKM_MPOOL_4
+#define RTKM_MPOOL_4 0
+#endif
+#ifndef RTKM_MPOOL_5
+#define RTKM_MPOOL_5 0
+#endif
+#ifndef RTKM_MPOOL_6
+#define RTKM_MPOOL_6 0
+#endif
+#ifndef RTKM_MPOOL_7
+#define RTKM_MPOOL_7 0
+#endif
+#ifndef RTKM_MPOOL_8
+#define RTKM_MPOOL_8 0
