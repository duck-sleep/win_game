+
+	psecuritypriv->wpa_psk = 0;
+
+	/* wpa2 */
+	akm = 0;
+	gmcs = 0;
+	group_cipher = 0;
+	pairwise_cipher = 0;
+	psecuritypriv->wpa2_group_cipher = _NO_PRIVACY_;
