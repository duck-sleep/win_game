+		chplan->txpwr_lmt_override = TXPWR_LMT_DEF;
+		#if defined(CONFIG_80211AX_HE) || defined(CONFIG_80211AC_VHT) || CONFIG_IEEE80211_BAND_5GHZ
+		chplan->proto_en = CHPLAN_PROTO_EN_ALL;
