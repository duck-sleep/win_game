+u8 rtw_set_chplan_cmd(_adapter *adapter, int flags, u8 chplan, u8 chplan_6g, enum rtw_regd_inr inr)
+{
+	return _rtw_set_chplan_cmd(adapter, flags
+		, chplan, chplan_6g, NULL
+		, REGD_SRC_RTK_PRIV, inr
+		, NULL, RTW_RLINK_MAX
+		, NULL);
+}
