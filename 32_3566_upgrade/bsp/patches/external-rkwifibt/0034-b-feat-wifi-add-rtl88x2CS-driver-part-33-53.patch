+{
+	struct dm_struct *dm = (struct dm_struct *)dm_void;
+	struct odm_power_trim_data *power_trim_info = &dm->power_trim_data;
+
+	u8 pg_power = 0, i, j;
+
+	odm_efuse_one_byte_read(dm, PPG_2GL_TX_10C, &pg_power, false);
