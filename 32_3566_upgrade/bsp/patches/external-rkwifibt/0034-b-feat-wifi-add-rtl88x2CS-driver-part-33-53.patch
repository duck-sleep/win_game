+	odm_efuse_one_byte_read(dm, TSSI_5GH1_TXA_35B, &pg_power[6], false);
+	odm_efuse_one_byte_read(dm, TSSI_5GH2_TXA_35B, &pg_power[7], false);
+
+	j = 0;
+	for (i = 0; i < 8; i++) {
+		RF_DBG(dm, DBG_RF_MP, "======>%s hide efuse value=x%x\n",
