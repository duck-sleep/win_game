+
+	odm_efuse_one_byte_read(dm, TSSI_2GM_TXA_35B, &pg_power[0], false);
+	odm_efuse_one_byte_read(dm, TSSI_2GH_TXA_35B, &pg_power[1], false);
+	odm_efuse_one_byte_read(dm, TSSI_5GL1_TXA_35B, &pg_power[2], false);
