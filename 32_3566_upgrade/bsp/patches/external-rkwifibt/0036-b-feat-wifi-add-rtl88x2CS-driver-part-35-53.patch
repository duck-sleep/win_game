+		dack->msbk_d[0][1][i] = (u16)odm_get_bb_reg(dm, 0x283c,
+							    0x7fc0000);
+	}
+
+	odm_set_bb_reg(dm, 0x4130, BIT(30), 0x0);
+	odm_set_bb_reg(dm, 0x4160, 0xfc000000, 0x3c);
+
+	for (i = 0; i < 0xf; i++) {
+		odm_set_bb_reg(dm, 0x41b0, 0xf0000000, i);
