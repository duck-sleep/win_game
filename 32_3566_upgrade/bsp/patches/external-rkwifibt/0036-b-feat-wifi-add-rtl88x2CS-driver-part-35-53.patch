+			if (KFAIL && iqk_info->retry_count[0][path][RXIQK2] < 2)
+				iqk_info->retry_count[0][path][RXIQK2]++;
+			else if (KFAIL) {
+				iqk_info->rxiqk_fail_code[0][path] = 2;
+				iqk_info->rxiqk_step = RXK_STEP_8822C;
