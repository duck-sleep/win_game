+void halrf_polling_check_8822c(void *dm_void, u32 add, u32 bmask, u32 data)
+{
+	struct dm_struct *dm = (struct dm_struct *)dm_void;
+	u32 c = 0;
+
+	c = 0;
+	while (c < 100000) {
+		c++;
+		if (odm_get_bb_reg(dm, add, bmask) == data)
+			break;
+	}
+	RF_DBG(dm, DBG_RF_DACK, "[DACK]c=%d\n",c);
+}
