+void _iqk_bbtx_path_8822c(
+	struct dm_struct *dm,
+	u8 path)
+{
+	u32 temp1 = 0, temp2 = 0;
+
+	switch (path) {
+	case RF_PATH_A:
+		temp1 = 0x11111111;
+		temp2 = 0x1;
+		break;
+	case RF_PATH_B:
+		temp1 = 0x22222222;
+		temp2 = 0x2;
+		break;
+	}
+	odm_write_4byte(dm, 0x820, temp1);
+	odm_set_bb_reg(dm, 0x824, 0xf0000, temp2);
+}
