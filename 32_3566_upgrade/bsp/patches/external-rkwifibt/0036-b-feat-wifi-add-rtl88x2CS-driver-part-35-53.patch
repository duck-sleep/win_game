+void _iqk_restore_mac_bb_8822c(
+	struct dm_struct *dm,
+	u32 *MAC_backup,
+	u32 *BB_backup,
+	u32 *backup_mac_reg,
+	u32 *backup_bb_reg)
+{
+	struct dm_iqk_info *iqk_info = &dm->IQK_info;
+	u32 i;	
+
+	/*toggle IGI*/
+	odm_write_4byte(dm, 0x1d70, 0x50505050);
+
