+	//odm_set_bb_reg(dm, R_0x1c68, 0x0f000000, 0xf);	
+	odm_set_bb_reg(dm, 0x1d58, 0xff8, 0x1ff);
+	odm_set_bb_reg(dm, 0x1864, BIT(31), 0x1);
+	odm_set_bb_reg(dm, 0x4164, BIT(31), 0x1);
