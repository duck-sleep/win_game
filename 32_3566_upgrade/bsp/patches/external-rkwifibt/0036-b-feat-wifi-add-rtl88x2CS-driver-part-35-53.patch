+	odm_set_bb_reg(dm, R_0x1bd4, MASKDWORD, 0x100400F0);
+	RF_DBG(dm, DBG_RF_DPK, "[DPK] S%d coef1 = 0x%08x\n", path,
+	       odm_get_bb_reg(dm, R_0x1bfc, MASKDWORD));
+	odm_set_bb_reg(dm, R_0x1bd4, MASKDWORD, 0x0D0400F0);
+	RF_DBG(dm, DBG_RF_DPK, "[DPK] S%d coef1 = 0x%08x\n", path,
