+u8 _dpk_check_fail_8822c(
+	struct dm_struct *dm,
+	boolean is_fail,
+	u32 dpk_txagc,
+	u8 path)
+{
+	struct dm_dpk_info *dpk_info = &dm->dpk_info;
+
+	u8 result;
+
+	if (!is_fail)
+		if (_dpk_coef_read_8822c(dm, path))
+			result = 1; /*check PASS*/
+		else
+			result = 0; /*check FAIL*/
+	else
+		result = 0; /*check FAIL*/
+	
+	_dpk_fill_result_8822c(dm, dpk_txagc, path, result);
+	return result;
+}
