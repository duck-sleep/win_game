+	IQK_CMD = 0xf8000208 | (1 << (path + 4));
+	odm_write_4byte(dm, 0x1b00, IQK_CMD);
+	odm_write_4byte(dm, 0x1b00, IQK_CMD + 0x1);
+
+	fail = _iqk_check_cal_8822c(dm, path, 0x1);
+	return fail;
+}
