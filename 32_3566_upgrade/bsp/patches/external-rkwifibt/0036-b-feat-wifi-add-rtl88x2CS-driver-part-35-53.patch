+
+				odm_set_bb_reg(dm, R_0x1d58, 0x00000008, 0x1);
+				odm_set_bb_reg(dm, R_0x1d58, 0x00000ff0, 0xff);
+				odm_set_bb_reg(dm, R_0x1a00, 0x00000003, 0x2);
