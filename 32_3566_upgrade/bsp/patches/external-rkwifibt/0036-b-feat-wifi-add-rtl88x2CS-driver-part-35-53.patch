+	} else {//direct access
+		if ((enum rf_path)path == RF_PATH_A)
+			odm_set_bb_reg(dm, 0x1c, BIT(31) | BIT(30), 0x2);
+		else if((enum rf_path)path == RF_PATH_B)
+			odm_set_bb_reg(dm, 0xec, BIT(31) | BIT(30), 0x2);
+		//odm_set_bb_reg(dm, 0x1c, BIT(31) | BIT(30), 0x2);
