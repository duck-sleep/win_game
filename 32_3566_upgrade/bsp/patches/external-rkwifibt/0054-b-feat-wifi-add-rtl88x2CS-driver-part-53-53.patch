diff --git a/drivers/rtl88x2CS/platform/platform_sprd_sdio.c b/drivers/rtl88x2CS/platform/platform_sprd_sdio.c
new file mode 100755
index 0000000..34061d0
--- /dev/null
+++ b/drivers/rtl88x2CS/platform/platform_sprd_sdio.c
@@ -0,0 +1,84 @@
+/******************************************************************************
