 drivers/skw6621s/seekwaveplatform_lite/sdio/skw_sdio_main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/skw6621s/seekwaveplatform_lite/sdio/skw_sdio_main.c b/drivers/skw6621s/seekwaveplatform_lite/sdio/skw_sdio_main.c
index b3a76fb..caaf9d3 100755
--- a/drivers/skw6621s/seekwaveplatform_lite/sdio/skw_sdio_main.c
+++ b/drivers/skw6621s/seekwaveplatform_lite/sdio/skw_sdio_main.c
@@ -857,7 +857,7 @@ static int skw_sdio_suspend(struct device *dev)
 	skw_sdio_dbg("[%s]enter\n", __func__);
 
 	if (skw_sdio->cp_state != 0)
-		return -EBUSY;
+		skw_sdio_warn("cp_state=%d, suspend anyway\n", skw_sdio->cp_state);
 
 	skw_sdio_set_suspend_indication();
 
