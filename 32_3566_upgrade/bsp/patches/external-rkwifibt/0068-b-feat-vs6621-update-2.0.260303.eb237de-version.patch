+	} else {
+		skwboot_log("%s:file:%s size:%d\n", __func__, boot_data->skw_nv_name,
+			    boot_data->nv_mem_size);
+	}
+	return 0;
+
+err:
+	skw_fw_free(boot_data);
+	return ret;
+}
