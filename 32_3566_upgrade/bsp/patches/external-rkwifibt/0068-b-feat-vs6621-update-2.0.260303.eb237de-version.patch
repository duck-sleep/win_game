+		goto err;
+	}
+	skwboot_log("%s:file:%s size:%d\n", __func__, boot_data->iram_file_path,
+		    boot_data->iram_dl_size);
+	//boot_data->dram_file_path = SKW_DRAM_FILE_PATH;
+	ret = skw_fw_file_read(boot_data->dram_file_path,
+			       &boot_data->dram_img_data,
