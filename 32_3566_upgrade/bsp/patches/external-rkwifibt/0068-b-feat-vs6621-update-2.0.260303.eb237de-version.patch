+
+void skw_dbg_dump(struct skw_core *skw)
+{
+	int i;
+	u64 nsecs;
+	unsigned long rem_nsec;
+
+	for (i = 0; i < skw->dbg.nr_cmd; i++) {
+		struct skw_dbg_cmd *cmd = &skw->dbg.cmd[i];
+
+		skw_info("cmd[%d].id: %d, seq: %d, flags: 0x%lx, loop: %d\n",
+			i, cmd->id, cmd->seq, cmd->flags, cmd->loop);
+
+		nsecs = cmd->trigger;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.trigger: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = cmd->build;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.build: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = cmd->xmit;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.xmit: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = cmd->done;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.done: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = cmd->ack;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.ack: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = cmd->assert;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("cmd.%d.%d.assert: %5lu.%06lu\n", cmd->id, cmd->seq,
+			(unsigned long)nsecs, rem_nsec / 1000);
+	}
+
+	for (i = 0; i < skw->dbg.nr_dat; i++) {
+		struct skw_dbg_dat *dat = &skw->dbg.dat[i];
+
+		nsecs = dat->trigger;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("dat.%d.%d.trigger: %5lu.%06lu\n",
+			i, dat->qlen, (unsigned long)nsecs, rem_nsec / 1000);
+
+		nsecs = dat->done;
+		rem_nsec = do_div(nsecs, 1000000000);
+		skw_info("dat.%d.%d.done: %5lu.%06lu\n",
+			i, dat->qlen, (unsigned long)nsecs, rem_nsec / 1000);
+	}
+}
+
+static int skw_rx_reorder_timeout_show(struct seq_file *seq, void *data)
+{
+	struct skw_core *skw = seq->private;
+
+	seq_printf(seq, "rx reorder timeout: %d ms\n",
+			skw->config->global.reorder_timeout);
+
+	return 0;
+}
+
+static int skw_rx_reorder_timeout_open(struct inode *inode, struct file *file)
+{
+	// return single_open(file, skw_tx_time_show, inode->i_private);
+	return single_open(file, skw_rx_reorder_timeout_show, skw_pde_data(inode));
+}
+
+static ssize_t skw_rx_reorder_timeout_write(struct file *fp, const char __user *buf,
+		size_t len, loff_t *offset)
+{
+	int i;
+	char cmd[32] = {0};
+	unsigned int timeout = 0;
+	struct skw_core *skw = skw_pde_data(file_inode(fp));
+
+	for (i = 0; i < 32; i++) {
+		char c;
+
+		if (get_user(c, buf))
+			return -EFAULT;
+
+		if (c == '\n' || c == '\0')
+			break;
+
+		if (isdigit(c) != 0)
+			cmd[i] = c;
+		else {
+			skw_warn("set fail, not number\n");
+			return -EFAULT;
+		}
+
+		buf++;
+	}
+
+	if (kstrtouint(cmd, 10, &timeout))
+		return -EFAULT;
+
+	skw->config->global.reorder_timeout = timeout;
+
+	return len;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+static const struct proc_ops skw_rx_reorder_timeout_fops = {
+	.proc_open = skw_rx_reorder_timeout_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+	.proc_write = skw_rx_reorder_timeout_write,
+};
+#else
+static const struct file_operations skw_rx_reorder_timeout_fops = {
+	.owner = THIS_MODULE,
+	.open = skw_rx_reorder_timeout_open,
+	.read = seq_read,
+	.release = single_release,
+	.write = skw_rx_reorder_timeout_write,
+};
+#endif
+
+void skw_core_dbg_init(struct wiphy *wiphy)
+{
+	struct skw_core *skw = wiphy_priv(wiphy);
+
+	skw_procfs_file(skw->pentry, "core", 0444, &skw_core_fops, skw);
+
+	skw_procfs_file(skw->pentry, "debug_info", 0444, &skw_debug_info_fops, skw);
+
+	skw_debugfs_file(skw->dentry, "assert", 0444, &skw_assert_fops, skw);
+
+	skw_debugfs_file(skw->dentry, "repeater", 0666, &skw_repeater_fops, skw);
+
+	skw_procfs_file(skw->pentry, "rx_reorder_timeout", 0444,
+			&skw_rx_reorder_timeout_fops, skw);
+
+}
+
+void skw_core_dbg_deinit(struct wiphy *wiphy)
+{
+}
