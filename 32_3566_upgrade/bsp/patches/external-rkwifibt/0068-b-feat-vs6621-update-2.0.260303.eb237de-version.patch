diff --git a/drivers/skw6621s/seekwaveplatform_lite/skwutil/skw_btlog.c b/drivers/skw6621s/seekwaveplatform_lite/skwutil/skw_btlog.c
new file mode 100755
index 0000000..e509f1f
--- /dev/null
+++ b/drivers/skw6621s/seekwaveplatform_lite/skwutil/skw_btlog.c
@@ -0,0 +1,462 @@
+/*
+ *
