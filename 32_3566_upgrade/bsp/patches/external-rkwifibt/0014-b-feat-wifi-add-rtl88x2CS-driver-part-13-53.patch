+				/* VHT */
+				rate_array_sz = rates_by_sections[VHT_1SSMCS0_1SSMCS9].rate_num;
+				rates = rates_by_sections[VHT_1SSMCS0_1SSMCS9].rates;
+				for (j = 0; j < rate_array_sz; ++j) {
