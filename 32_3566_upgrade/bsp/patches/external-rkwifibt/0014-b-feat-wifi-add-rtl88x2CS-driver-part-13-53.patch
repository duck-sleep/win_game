+				for (j = 0; j < rate_array_sz; ++j) {
+					power_index = phy_get_tx_power_index_ex(iface, path, OFDM, rates[j], bw, band, center_ch, ch);
+					rate = phy_get_rate_idx_of_txpwr_by_rate(rates[j]);
