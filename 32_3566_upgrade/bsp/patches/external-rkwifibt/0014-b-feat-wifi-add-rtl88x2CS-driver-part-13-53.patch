+		phy_set_bb_reg(pAdapter, rCCAonSec_Jaguar, BIT1, 0x1);
+		phy_set_bb_reg(pAdapter, 0x1000, bMaskByte2, 0x2);
+		phy_set_bb_reg(pAdapter, rRxPath_Jaguar, bMaskByte0, 0x88);
