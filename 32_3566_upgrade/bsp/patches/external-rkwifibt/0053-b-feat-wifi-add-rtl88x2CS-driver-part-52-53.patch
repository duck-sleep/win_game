+	if (dvobj->chip_type == RTL8822E) {
+		dvobj->HardwareType = HARDWARE_TYPE_RTL8822ES;
+		RTW_INFO("CHIP TYPE: RTL8822E\n");
+	}
+#endif
+
+}
