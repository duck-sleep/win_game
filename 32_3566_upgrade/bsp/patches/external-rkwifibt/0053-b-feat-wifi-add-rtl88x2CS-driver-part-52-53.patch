+/**
+ *	Returns driver error code,
+ *	0	no error
+ *	-1	Level 1 error, critical error and can't be recovered
+ *	-2	Level 2 error, normal error, retry to recover is possible
+ */
+static int linux_io_err_to_drv_err(int err)
+{
+	if (!err)
+		return 0;
+
+	/* critical error */
+	if ((err == -ESHUTDOWN) ||
+	    (err == -ENODEV) ||
+	    (err == -ENOMEDIUM))
+		return -1;
+
+	/* other error */
+	return -2;
+}
