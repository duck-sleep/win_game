+	if (!wiphy_data->du_wdev) {
+		wiphy_data->du_wdev = rtw_regd_alloc_du_wdev(wiphy);
+		if (!wiphy_data->du_wdev)
+			return;
+		rtw_regd_set_du_chdef(wiphy);
