+	alpha2_len = 3;
+	#else
+	alpha2_len = 2;
+	#endif
+
+	#if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 6, 0))
+	RTW_PRINT_SEL(sel, "initiator:%s, wiphy_idx:%d, type:%s\n"
+		, nl80211_reg_initiator_str(request->initiator)
+		, request->wiphy_idx
+		, nl80211_user_reg_hint_type_str(request->user_reg_hint_type));
+	#else
