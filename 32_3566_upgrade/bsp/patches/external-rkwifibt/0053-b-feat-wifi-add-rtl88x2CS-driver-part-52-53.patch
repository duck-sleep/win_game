+#ifdef CONFIG_PLATFORM_INTEL_BYT
+int rtw_sdio_set_power(int on)
+{
+
+	if (wlan_en_gpio >= 0) {
+		if (on)
+			gpio_set_value(wlan_en_gpio, 1);
+		else
+			gpio_set_value(wlan_en_gpio, 0);
+	}
+
+	return 0;
+}
+#endif /* CONFIG_PLATFORM_INTEL_BYT */
+
+module_init(rtw_drv_entry);
+module_exit(rtw_drv_halt);
