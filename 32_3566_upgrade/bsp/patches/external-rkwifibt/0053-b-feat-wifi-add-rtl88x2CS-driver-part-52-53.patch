+
+#endif /* CONFIG_USB_HCI */
+
+
+	if (precvbuf->pskb) {
+#ifdef CONFIG_PREALLOC_RX_SKB_BUFFER
+		rtkm_kfree_skb_any(precvbuf->pskb);
+#else
+		rtw_skb_free(precvbuf->pskb);
+#endif
+	}
+	return ret;
+
