+#define MAC_CLK_SPEED_BW_5M_10M	20 /* 20M */
+
+#define EFUSE_PCB_INFO_OFFSET	0xCA
+
+enum mac_clock_hw_def {
+	MAC_CLK_HW_DEF_80M = 0,
+	MAC_CLK_HW_DEF_40M = 1,
+	MAC_CLK_HW_DEF_20M = 2,
+	MAC_CLK_HW_DEF_20M_BW_5 = 3,
+};
