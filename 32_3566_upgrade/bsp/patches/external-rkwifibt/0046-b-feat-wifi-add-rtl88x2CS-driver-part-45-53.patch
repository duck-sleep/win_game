index 0000000..c3765f0
--- /dev/null
+++ b/drivers/rtl88x2CS/include/rtw_btcoex.h
@@ -0,0 +1,468 @@
+/******************************************************************************
+ *
+ * Copyright(c) 2013 - 2017 Realtek Corporation.
