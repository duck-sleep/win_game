+	u8 preference_en;
+	u8 roam_target_addr[ETH_ALEN];
+	u32	last_nb_rpt_entries;
+	u8 nb_rpt_is_same;
+	s8 disassoc_waiting;
+	_timer roam_scan_timer;
+	_timer disassoc_chk_timer;	
+
+	u32 features;
+};
