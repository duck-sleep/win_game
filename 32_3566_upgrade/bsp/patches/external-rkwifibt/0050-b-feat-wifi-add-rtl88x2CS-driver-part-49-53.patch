 drivers/rtl88x2CS/include/linux/wireless.h | 87 ++++++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100755 external/rkwifibt/drivers/rtl88x2CS/include/linux/wireless.h

diff --git a/drivers/rtl88x2CS/include/linux/wireless.h b/drivers/rtl88x2CS/include/linux/wireless.h
