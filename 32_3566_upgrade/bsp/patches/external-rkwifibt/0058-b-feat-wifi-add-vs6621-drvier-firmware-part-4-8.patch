+static int skw_set_cqm_rssi_range_config(struct wiphy *wiphy,
+							struct net_device *dev,
+							s32 rssi_low, s32 rssi_high)
+{
+	struct skw_set_cqm_rssi_param cqm_param = {0};
+	s32 val = rssi_high - rssi_low;
