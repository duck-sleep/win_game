+static int skw_sync_adma_cmd_disable_irq_tx(struct skw_core *skw,
+		struct sk_buff_head *list, int lmac_id, int port,
+		struct scatterlist *sgl, int nents, int tx_len)
+{
+	if (!skw->hw_pdata || !skw->hw_pdata->suspend_adma_cmd)
