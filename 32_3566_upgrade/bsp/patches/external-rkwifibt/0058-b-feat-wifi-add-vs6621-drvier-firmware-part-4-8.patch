+		.width_max = SKW_WIDTH_UPPER(WMAX),                          \
+		.pri_min = PMIN - SKW_PRI_TOLERANCE,                         \
+		.pri_max = PMAX * PRF + SKW_PRI_TOLERANCE,                   \
+		.nr_pri = PRF,                                               \
+		.ppb = PPB * PRF,                                            \
+		.ppb_thresh = SKW_PPB_THRESH_RATE(PPB, RATE),                \
+		.max_pri_tolerance = SKW_PRI_TOLERANCE,                      \
+		.chirp = CHIRP,                                              \
+	}                                                                    \
+}
