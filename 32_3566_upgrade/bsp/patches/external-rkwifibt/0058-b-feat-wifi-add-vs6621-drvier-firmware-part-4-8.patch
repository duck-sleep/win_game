+static struct skw_iftype_ext_cap *skw_get_iftype_ext_cap(u8 iftype)
+{
+	int i;
+	struct skw_iftype_ext_cap *capab = NULL;
+
+	for (i = 0; i < NUM_NL80211_IFTYPES; i++) {
+		if (iftype_ext_cap[i].iftype == iftype)
+			capab = &iftype_ext_cap[iftype];
+	}
