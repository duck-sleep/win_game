+static void skw_ndo_tx_timeout(struct net_device *dev
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+				, unsigned int txqueue
+#endif
+				SKW_NULL)
+{
+	struct skw_iface *iface = (struct skw_iface *)netdev_priv(dev);
+	struct skw_core *skw;
+
+	if (!iface) {
+		skw_err("iface NULL\n");
+		return;
