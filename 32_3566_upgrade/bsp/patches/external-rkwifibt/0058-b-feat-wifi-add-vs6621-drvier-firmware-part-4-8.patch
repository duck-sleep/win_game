+static int skw_set_capa(struct skw_core *skw, int capa)
+{
+	int idx, bit;
+	int size = sizeof(skw->ext_capa);
+
+	idx = capa / BITS_PER_BYTE;
+	bit = capa % BITS_PER_BYTE;
+
+	BUG_ON(idx >= size);
+
+	skw->ext_capa[idx] |= BIT(bit);
+
+	return 0;
+}
