+		struct {
+			u32 mask;
+			u32 val;
+			bool equal;
+		} vm; /* value match */
+	} u;
+	bool trace;
+	char *tag;
+	bool (*assert_protsel)(_adapter *adapter, u32 addr, u8 len);
+};
