+	if(skw_sdio->gpio_out>=0){
+		switch (gpio_get_value(skw_sdio->gpio_out)) {
+		case 0:
+			str = "low";
+			break;
+		case 1:
+			str = "high";
+			break;
+		default:
+			str = "invalid";
+			break;
