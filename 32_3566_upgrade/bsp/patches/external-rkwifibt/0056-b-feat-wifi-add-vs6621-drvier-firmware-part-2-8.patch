+ ********************************************************************* */
+static int skw_usb_io_pre_reset(struct usb_interface *interface)
+{
+	/* there is a lock to prevent we reset a interface when
+	 * urb submit
+	 */
+	struct usb_port_struct *port;
+
+	port = usb_get_intfdata(interface);
+
+	return 0;
+}
