+/****************************************************************
+*Description:skw_sdio_poweron_mem
+*Func:used the ap boot cp interface;
+*Others:
+*Author：JUNWEI.JIANG
+*Date:2022-07-15
+****************************************************************/
+int skw_sdio_poweron_mem(int index)
+{
+	int ret=0;
+	struct skw_sdio_data_t *skw_sdio = skw_sdio_get_data();
