+char *log0_file = "log000";
+char *log1_file = "log111";
+char *log_file;
+
+char* skw_code_mem = "code_mem_100000_7a000";
+char* skw_data_mem = "data_mem_20200000_40000";
+char* skw_cscb_mem = "cscb_mem_e000ed00_300";
