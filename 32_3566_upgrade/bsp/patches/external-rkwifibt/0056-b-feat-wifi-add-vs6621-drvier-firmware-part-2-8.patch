+/***************************************************************************
+ * Description:
+ *Seekwave tech LTD
+ *Author:
+ *Date:
+ *Modify:
+ * ************************************************************************/
+int dloader_get_chip_id(void *buf, unsigned int buf_size)
+{
+	int len = strlen(usb_ports[0]->udev->product);
+	memcpy(buf, usb_ports[0]->udev->product, strlen(usb_ports[0]->udev->product));
+	return len;
+}
