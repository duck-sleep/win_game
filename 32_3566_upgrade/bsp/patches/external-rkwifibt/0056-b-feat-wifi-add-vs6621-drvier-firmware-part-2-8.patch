+	hi_drv_gpio_write_bit(MODEM_ENABLE_GPIO,0);
+	msleep(POWERON_DELAY_TIME);
+	hi_drv_gpio_write_bit(MODEM_ENABLE_GPIO,1);
+#else
+	printk("self skw chip power reset !!\n");
+	skw_chip_power_ops(0);
+	msleep(POWERON_DELAY_TIME);
+	skw_chip_power_ops(1);
+#endif
+}
