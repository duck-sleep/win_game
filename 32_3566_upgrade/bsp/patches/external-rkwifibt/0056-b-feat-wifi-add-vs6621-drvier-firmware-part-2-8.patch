+
+static int skw_sdio_reset_card(void)
+{
+	int ret;
+	int skw_sd_id = SKW_MMC_HOST_SD_INDEX;
+	skw_sdio_info(" [+]\n");
+	ret = skw_sdio_mmc_rescan(skw_sd_id);
+	if (ret < 0) {
+		skw_sdio_err("the reset card fail try again\n");
+		ret = skw_sdio_mmc_rescan(skw_sd_id);
+	}
+	skw_sdio_info(" [-]\n");
+	return ret;
+}
