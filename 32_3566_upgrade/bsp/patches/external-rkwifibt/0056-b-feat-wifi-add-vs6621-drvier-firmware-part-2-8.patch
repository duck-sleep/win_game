+		skw_sdio->tx_req_map &= ~(1<<portno);
+		skw_port_log(portno,"%s port%d size=%d 0x%x 0x%x\n",
+			__func__, portno, size, data[0], data[1]);
+		return ret;
+	} else {
+		for(i=0; i<2; i++) {
+			try_to_wakeup_modem(portno);
+			if(!(ret = skw_sdio_sdma_write(buffer, count))) {
+				port->total += count;
+				port->sent_packet++;
