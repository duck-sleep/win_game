+int skw_recovery_mode(void)
+{
+	int ret=0;
+	struct skw_sdio_data_t *skw_sdio = skw_sdio_get_data();
+	skw_sdio_info("the CHIPID:%s \n", (char *)&skw_sdio->chip_id);
