+	struct skw_sdio_data_t *skw_sdio = skw_sdio_get_data();
+
+	sdio_unregister_driver(&skw_sdio_driver);
+	skw_sdio_info(" sdio_unregister_driver: %s\n", skw_sdio_driver.name);
