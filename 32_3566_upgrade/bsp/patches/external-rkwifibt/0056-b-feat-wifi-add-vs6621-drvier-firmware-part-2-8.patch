+	.max_buffer_size = 0x800,
+	.align_value = 4,
+	.hw_sdma_rx = get_sleep_status,
+	.hw_sdma_tx = set_sleep_status,
+	.open_port = bt_start_service,
+	.close_port = bt_stop_service,
+};
