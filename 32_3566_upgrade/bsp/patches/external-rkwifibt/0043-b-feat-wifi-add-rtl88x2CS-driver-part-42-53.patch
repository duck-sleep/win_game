+	ops->init_recv_priv = rtl8822cs_init_recv_priv;
+	ops->free_recv_priv = rtl8822cs_free_recv_priv;
+#ifdef CONFIG_RECV_THREAD_MODE
+	ops->recv_hdl = rtl8822cs_recv_hdl;
