+if [ -f "usr/local/first_boot_flag" ]; then
+    echo "first_boot_flag skip run !"
+    exit 0
+else
+	echo "run post-debian.sh"
+fi
+
 rm -rfv sha256sum*
 
 if [ "$RK_DEBIAN_USER" != linaro ]; then
