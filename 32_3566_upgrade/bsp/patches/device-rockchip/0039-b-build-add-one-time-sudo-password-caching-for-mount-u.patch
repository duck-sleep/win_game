From 59c66fc3d0638a13de7dc126ef044eea356ca961 Mon Sep 17 00:00:00 2001
From: huangcm <cmhuang@kickpi.com>
Date: Tue, 26 May 2026 15:29:44 +0800
Subject: [PATCH 31/34] build: add one-time sudo password caching for
 mount/umount/losetup

Origin: kickpi f3c2486d2b5ae089bf214fc0fa4df4bf89a06ab2
---
 common/scripts/build.sh | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/common/scripts/build.sh b/common/scripts/build.sh
index a606d42..d698126 100755
--- a/common/scripts/build.sh
+++ b/common/scripts/build.sh
@@ -810,6 +810,24 @@ main()
 		sort | sed "s/\(PASSWORD=\).*/\1********/"
 	echo
 
+	# One-time sudo password caching for mount/umount/losetup
+	if [ -z "$SUDO_ASKPASS" ] && ! sudo -n true 2>/dev/null; then
+		read -s -p "[sudo] password for $USER: " SUDO_PASS
+		echo
+		ASKPASS_FILE=$(mktemp)
+		cat > "$ASKPASS_FILE" <<- 'SUDOASKEOF'
+		#!/bin/sh
+		echo "$SUDO_PASS"
+		SUDOASKEOF
+		chmod +x "$ASKPASS_FILE"
+		export SUDO_ASKPASS="$ASKPASS_FILE"
+		export SUDO_PASS
+		trap 'rm -f "$ASKPASS_FILE"; unset SUDO_PASS' EXIT
+		# Override sudo to use -A (askpass) mode
+		sudo() { command sudo -A "$@"; }
+		export -f sudo
+	fi
+
 	# Pre-build stage (submodule configuring, etc.)
 	run_build_hooks pre-build $OPTIONS
 
-- 
2.34.1

