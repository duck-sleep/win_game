From 42291d4f9abb0bbf88d4c0c10e2e55f4b2acea67 Mon Sep 17 00:00:00 2001
From: huangcm <cmhuang@kickpi.com>
Date: Wed, 25 Mar 2026 13:48:28 +0800
Subject: [PATCH 14/34] feat(build): fix build lunch config

Origin: kickpi d6c702985d86761a3c0105d872a9c7c0d9b7dda4
---
 common/scripts/mk-config.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/common/scripts/mk-config.sh b/common/scripts/mk-config.sh
index 9fc759f..292c75a 100755
--- a/common/scripts/mk-config.sh
+++ b/common/scripts/mk-config.sh
@@ -216,8 +216,8 @@ INIT_CMDS="chip defconfig lunch [^:]*_defconfig \
 init_hook()
 {
 	case "${1:-default}" in
-		chip) shift; choose_chip $@ ;;
-		lunch|defconfig) shift; choose_defconfig $@ ;;
+		lunch|chip) shift; choose_chip $@ ;;
+		defconfig) shift; choose_defconfig $@ ;;
 		*_defconfig) switch_defconfig "$1" ;;
 		olddefconfig | savedefconfig | menuconfig)
 			prepare_config
-- 
