From ac9f0a767e739778b8f5362b4c6fd5e05cc6461b Mon Sep 17 00:00:00 2001
From: huangcm <cmhuang@kickpi.com>
Date: Sat, 28 Mar 2026 10:38:25 +0800
Subject: [PATCH 17/34] feat(multi_dtb): add multi dtb config v1

Origin: kickpi 7f16dc977278f80be1efa41d122c8aed1e974f70
---
 common/scripts/mk-all.sh       | 10 +++++++++-
 common/scripts/mk-kernel.sh    |  8 +++++++-
 common/scripts/mk-updateimg.sh | 12 ++++++++++++
 3 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/common/scripts/mk-all.sh b/common/scripts/mk-all.sh
index da1eb2e..20d5692 100755
--- a/common/scripts/mk-all.sh
+++ b/common/scripts/mk-all.sh
@@ -129,10 +129,14 @@ clean_hook()
 	rm -rf "$RK_OUTDIR" "$RK_OUTDIR"/releases
 }
 
-BUILD_CMDS="all all-release"
+BUILD_CMDS="all all-release all_multi_dtb"
 build_hook()
 {
 	case "$1" in
+		all_multi_dtb)
+            export MULTI_DTB=true
+            build_all
+            ;;
 		all) build_all ;;
 		all-release) build_all_release $@ ;;
 	esac
@@ -147,6 +151,10 @@ post_build_hook()
 source "${RK_BUILD_HELPER:-$(dirname "$(realpath "$0")")/build-helper}"
 
 case "${1:-all-release}" in
+    all_multi_dtb)
+        export MULTI_DTB=true
+        build_all
+        ;;
 	all) build_all ;;
 	all-release) build_all_release $@ ;;
 	release) build_release $@ ;;
diff --git a/common/scripts/mk-kernel.sh b/common/scripts/mk-kernel.sh
index 0f57954..704a4cc 100755
--- a/common/scripts/mk-kernel.sh
+++ b/common/scripts/mk-kernel.sh
@@ -64,6 +64,12 @@ do_build()
 		"$RK_SCRIPTS_DIR/check-kernel.sh"
 	fi
 
+    case "$1" in
+        kernel_multi_dtb)
+        export MULTI_DTB=true
+        ;;
+    esac
+
 	case "$1" in
 		kernel-config | kconfig)
 			KERNEL_CONFIG_DIR="kernel/arch/$RK_KERNEL_ARCH/configs"
@@ -413,7 +419,7 @@ pre_build_hook_dry()
 	DRY_RUN=1 pre_build_hook $@
 }
 
-BUILD_CMDS="$KERNELS kernel recovery-kernel kernel-modules modules"
+BUILD_CMDS="$KERNELS kernel recovery-kernel kernel-modules modules kernel_multi_dtb"
 build_hook()
 {
 	check_config RK_KERNEL RK_KERNEL_CFG || false
diff --git a/common/scripts/mk-updateimg.sh b/common/scripts/mk-updateimg.sh
index e3571ae..e260bed 100755
--- a/common/scripts/mk-updateimg.sh
+++ b/common/scripts/mk-updateimg.sh
@@ -131,6 +131,18 @@ do_build_updateimg()
 		*ota*) EDIT_CMD="edit-ota-package-file" ;;
 		*) EDIT_CMD="edit-package-file" ;;
 	esac
+
+    #DTS_DIR="kernel-6.1/arch/arm64/boot/dts/rockchip/${RK_KERNEL_DTS_NAME}.dtsi"
+    #LCD_NAME=`grep '^#include.*kickpi.*lcd-[^g][^p]' $DTS_DIR | grep -Ev "hdmi|typec" |  sed 's/^#include.*-lcd-//g' | sed 's/.dts.*//g'`
+    DATE=`date +%Y%m%d-%H%M%S`
+    echo "${RK_FIRMWARE_DIR}/update-${RK_KERNEL_DTS_NAME/\//-}-$RK_ROOTFS_SYSTEM-$DATE.img"
+    rm -rf "${RK_FIRMWARE_DIR}"/update-*.img
+    if [ "$MULTI_DTB" = "true" ]; then
+    	ln -rsf "$IMAGE_DIR/update.img" "${RK_FIRMWARE_DIR}/update-${RK_KERNEL_DTS_NAME/\//-}-$RK_ROOTFS_SYSTEM-multi-$DATE.img"
+    else
+    	ln -rsf "$IMAGE_DIR/update.img" "${RK_FIRMWARE_DIR}/update-${RK_KERNEL_DTS_NAME/\//-}-$RK_ROOTFS_SYSTEM-$DATE.img"
+    fi
+
 	notice "\nRun 'make $EDIT_CMD' if you want to change the package-file.\n"
 }
 
