+build_ubuntu()
+{
+	check_config RK_UBUNTU || false
+
+	IMAGE_DIR="${1:-$RK_OUTDIR/ubuntu}"
+	ARCH=${RK_UBUNTU_ARCH:-armhf}
+
+	"$RK_SCRIPTS_DIR/check-ubuntu.sh"
+
+	message "=========================================="
+	message "          Start building $RK_UBUNTU_VERSION($ARCH)"
+	message "=========================================="
+
+	if [ "$RK_UBUNTU_SERVER" ]; then
+		TARGET=base
+	else
+		TARGET=desktop
+	fi
+
+	cd ubuntu
+
+	UBUNTU_SCRIPT=mk-rootfs-$RK_UBUNTU_VERSION.sh
+
+	RELEASE=$RK_UBUNTU_VERSION TARGET=$TARGET ARCH=$ARCH ./mk-base-ubuntu.sh
+
+	VERSION=debug ARCH=$ARCH ./$UBUNTU_SCRIPT
+
+	./mk-image.sh
+
+	if ! [ -r "$RK_LOG_DIR/post-rootfs.log" ]; then
+		warning "Building without post-rootfs stage!"
+	fi
+
+	ln -rsf "$PWD/ubuntu-rootfs.img" "$IMAGE_DIR/rootfs.ext4"
+
+	finish_build build_ubuntu $@
+}
