diff --git a/.chips/rk3588/amp_linux.its b/.chips/rk3588/amp_linux.its
new file mode 100644
index 0000000..9c7e0f4
--- /dev/null
+++ b/.chips/rk3588/amp_linux.its
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright (c) 2023 Rockchip Electronics Co., Ltd.
+ */
+
+/dts-v1/;
+/ {
+	description = "FIT source file for rockchip AMP";
+	#address-cells = <1>;
+
+	images {
+		amp3 {
+			description  = "bare-mental-cpu3";
+			data         = /incbin/("cpu3.bin");
+			type         = "firmware";
+			compression  = "none";
+			arch         = "arm64";
+			thumb        = <0>;
+			hyp          = <0>;
+			udelay       = <10000>;
+			cpu          = <0x300>;       //0x300 is a55 core3, 0x700 is a76 core3
+			load         = <0x01800000>;
+
+			compile {
+				size         = <0x00800000>;
+				sram_start   = <0xff000000>;
+				sram_size    = <0x00100000>;
+				sys          = "rtt";    // "hal" or "rtt"
+				core         = "ap";
+				rtt_config   = "board/rk3588_evb1/defconfig"
+				rtt_exec     = "prebuilts/gcc/linux-x86/aarch64/arm-gnu-toolchain-13.2.Rel1-x86_64-aarch64-none-elf/bin"
+				cc           = "prebuilts/gcc/linux-x86/aarch64/arm-gnu-toolchain-13.2.Rel1-x86_64-aarch64-none-elf/bin/aarch64-none-elf-"
+			};
+
+			hash {
+				algo = "sha256";
+			};
+		};
+	};
+
+	share {
+		shm_base        = <0x07800000>;
+		shm_size        = <0x00400000>;
+		rpmsg_base      = <0x07c00000>;
+		rpmsg_size      = <0x00600000>;
+	};
+
+	configurations {
+		default = "conf";
+		conf {
+			description = "Rockchip AMP images";
+			rollback-index = <0x0>;
+			loadables = "amp3";
+
+			signature {
+				algo = "sha256,rsa2048";
+				padding = "pss";
+				key-name-hint = "dev";
+				sign-images = "loadables";
+			};
+
+			/* - run linux on cpu0
+			 * - it is brought up by amp(that run on U-Boot)
+			 * - it is boot entry depends on U-Boot
+			 */
+			linux {
+				description  = "linux-os";
+				arch         = "arm64";
+				cpu          = <0x000>;
+				thumb        = <0>;
+				hyp          = <0>;
+				udelay       = <0>;
+				load         = <0x02100000>;
+				load_c       = <0x05480000>;
+			};
+		};
+	};
+};
