+++ b/arch/arm64/boot/dts/rockchip/rk3562-kickpi-k3b-extend-20pin.dtsi
@@ -0,0 +1,112 @@
+/*
+	默认的配置
+	default configuration
+*/
+
+&i2c4 {
+	status = "okay";
+	pinctrl-names = "default";
+    pinctrl-0 = <&i2c4m0_xfer>;
+};
+
+
+&uart5 {
+	status = "okay";
+    pinctrl-names = "default";
+    pinctrl-0 = <&uart5m1_xfer>;
+};
+
+&uart8 {
+	status = "okay";
+    pinctrl-names = "default";
+    pinctrl-0 = <&uart8m0_xfer>;
+};
+
+&spi0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0m1_pins>;
+
+	spidev0: spidev@0 {
+		compatible = "rockchip,spidev";
+		status = "okay";
+		reg = <0>;
+		spi-max-frequency = <24000000>;
+	};
+};
+
+&pwm3 {
+	status = "okay";
+	pinctrl-names = "active";
+	pinctrl-0 = <&pwm3m1_pins>;
+};
+
+&leds {
+	gpio3c1 {
+		gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio2a1 {
+		gpios = <&gpio2 RK_PA1 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+};
+
+/*
+	其他可能的配置
+	Other possible configurations
+*/
+/*
+
+&leds {
+	gpio3b5 {
+		gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio3b4 {
+		gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio3b6 {
+		gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio3b7 {
+		gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio3c0 {
+		gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+	gpio1d0 {
