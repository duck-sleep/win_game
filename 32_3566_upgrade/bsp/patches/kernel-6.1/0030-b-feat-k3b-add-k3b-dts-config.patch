+    headphone {
+        hp_det: hp_det {
+            rockchip,pins =
+                <3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
+        };
+    };
+	
+};
+
+
+&sdmmc0 {
+	max-frequency = <200000000>;
+	no-sdio;
+	no-mmc;
+	bus-width = <4>;
+	cap-mmc-highspeed;
+	cap-sd-highspeed;
+	supports-sd;
+	disable-wp;
+	sd-uhs-sdr104;
+	// vmmc-supply = <&vcc_sd>;
+	vqmmc-supply = <&vccio_sd>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
