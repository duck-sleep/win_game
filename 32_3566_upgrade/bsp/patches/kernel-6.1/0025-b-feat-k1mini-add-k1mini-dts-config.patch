+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            csidphy_out: endpoint@0 {
+                reg = <0>;
+                remote-endpoint = <&isp0_in>;
+            };
+        };
+    };
+};
+
+&i2c4 {
+	status = "okay";
+
+	ov5647: ov5647@36 {
