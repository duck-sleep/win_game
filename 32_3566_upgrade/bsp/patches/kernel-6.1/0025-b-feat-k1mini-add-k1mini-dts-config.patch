diff --git a/arch/arm64/boot/dts/rockchip/rk3568-kickpi-eth-gmac0.dtsi b/arch/arm64/boot/dts/rockchip/rk3568-kickpi-eth-gmac0.dtsi
new file mode 100755
index 0000000..ccacbed
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3568-kickpi-eth-gmac0.dtsi
@@ -0,0 +1,36 @@
+
+
+&gmac0 {
+	phy-mode = "rgmii";
+	clock_in_out = "output";
+
+	snps,reset-gpio = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	/* Reset time is 20ms, 100ms for rtl8211f */
+	snps,reset-delays-us = <0 20000 100000>;
+
+	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
+	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>, <&cru CLK_MAC0_2TOP>;
+	assigned-clock-rates = <0>, <125000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac0_miim
+		     &gmac0_tx_bus2
+		     &gmac0_rx_bus2
+		     &gmac0_rgmii_clk
+		     &gmac0_rgmii_bus>;
+
+	tx_delay = <0x21>;
+	rx_delay = <0x3c>;
+
+	phy-handle = <&rgmii_phy0>;
+	status = "okay";
+};
+
+
+&mdio0 {
+	rgmii_phy0: phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+	};
+};
