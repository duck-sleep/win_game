diff --git a/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi
index ecf5bfe..7405ef2 100755
--- a/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi
@@ -20,6 +20,28 @@ vcc_camera: vcc-camera-regulator {
 		regulator-boot-on;
 	};
 
+	vcc_camera_rst: vcc-camera-rst {
+		compatible = "regulator-fixed";
+		gpio = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&camera_rst>;
+		regulator-name = "cam_rst";
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	vcc_camera_mclk: vcc-camera-mclk {
+		compatible = "regulator-fixed";
+		gpio = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
+		// pinctrl-names = "default";
+		// pinctrl-0 = <&camera_rst>;
+		regulator-name = "cam_mclk";
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
 	ext_cam_clk: external-camera0-clock {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -51,10 +73,24 @@ camera_pwr: camera-pwr {
 				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
 		};
 
+		camera_rst: camera-rst {
+			rockchip,pins =
+				/* camera power en */
+				<4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
 	};
 
 };
 
+&i2c2m1_xfer {
+	rockchip,pins =
+		/* i2c2_sclm1 */
+		<4 RK_PB5 1 &pcfg_pull_up_smt>,
+		/* i2c2_sdam1 */
+		<4 RK_PB4 1 &pcfg_pull_up_smt>;
+};
+
 &i2c2 {
 	status = "okay";
     pinctrl-0 = <&i2c2m1_xfer>;
@@ -66,7 +102,7 @@ ov5647: ov5647@36 {
 		clocks = <&ext_cam_25m_clk>;
 		clock-names = "xvclk";
 
-		// pwdn-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		// pwdn-gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
 		// power-domains = <&power RK3568_PD_VI>;
 		avdd-supply = <&vcc_camera>;
 
@@ -81,7 +117,7 @@ ov5647_out: endpoint {
 			};
 		};
 	};
-	
+
 	// 0c / 36
    	ov13850: ov13850@36 {
 		compatible = "ovti,ov13850";
@@ -117,10 +153,10 @@ imx415_0: imx415@37 {
 		reg = <0x37>;
 		clocks = <&ext_cam_37m_clk>;
 		clock-names = "xvclk";
-		
+
 		power-domains = <&power RK3568_PD_VI>;
 		// avdd-supply = <&vcc_camera>;
-		
+
 		rockchip,camera-module-index = <0>;
 		rockchip,camera-module-facing = "back";
 		rockchip,camera-module-name = "CMK-OT1607-FV1";
@@ -212,4 +248,4 @@ &rkcif {
 
 &rkcif_mmu {
 	status = "okay";
-};
+};
