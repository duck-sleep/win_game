+static int panel_notify_callback(struct notifier_block *nb, unsigned long action, void *data)
+{
+    struct goodix_ts_data *ts = container_of(nb, struct goodix_ts_data, nb);
+    struct panel_simple_notify_data *pdata = data;
+
+    if (pdata->panel != ts->panel)
+        return NOTIFY_DONE;
+
+    switch (pdata->power_state) {
+        case PANEL_SIMPLE_POWER_ON:
+            if (!ts->panel_on) {
+                GTP_INFO("%s %d\n", __func__, __LINE__);
+                goodix_ts_resume(ts);
+                ts->panel_on = 1;
+            }
+            break;
+        case PANEL_SIMPLE_POWER_OFF:
+            if (ts->panel_on) {
+                GTP_INFO("%s %d\n", __func__, __LINE__);
+                goodix_ts_suspend(ts);
+                ts->panel_on = 0;
+            }
+            break;
+    }
+    return NOTIFY_DONE;
+}
