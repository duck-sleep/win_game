@@ -222,13 +226,66 @@ struct panel_simple {
 	struct rockchip_panel_notifier panel_notifier;
 
 	struct rockchip_drm_sub_dev sub_dev;
+
+    char panel_name[32];
+    struct list_head list;
+    struct blocking_notifier_head notifier_list;
 };
 
+static LIST_HEAD(panel_simple_list);
+
 static inline void panel_simple_msleep(unsigned int msecs)
 {
 	usleep_range(msecs * 1000, msecs * 1000 + 100);
 }
 
+static void panel_simple_send_notify(struct panel_simple *p, int state)
+{
+    struct panel_simple_notify_data ndata = {
+        .power_state = state,
+        .panel = &p->base,
+    };
+    blocking_notifier_call_chain(&p->notifier_list, state, &ndata);
+}
+
+struct drm_panel *drm_panel_get_by_name(const char *name)
+{
+       struct panel_simple *panel;
+       struct drm_panel *drm_panel = NULL;
+
+       if (!name || strlen(name) == 0) {
+               pr_err("drm_panel_get_by_name: empty name\n");
+               return NULL;
+       }
+
+       list_for_each_entry(panel, &panel_simple_list, list) {
+               if (strcmp(panel->panel_name, name) == 0) {
+                       drm_panel = &panel->base;
+                       break;
+               }
+       }
+
+       if (!drm_panel)
+               pr_warn("drm_panel_get_by_name: no panel found for %s\n", name);
+
+       return drm_panel;
+}
+EXPORT_SYMBOL_GPL(drm_panel_get_by_name);
+
+int panel_simple_register_notifier(struct drm_panel *panel, struct notifier_block *nb)
+{
+    struct panel_simple *p = container_of(panel, struct panel_simple, base);
+    return blocking_notifier_chain_register(&p->notifier_list, nb);
+}
+EXPORT_SYMBOL_GPL(panel_simple_register_notifier);
+
+int panel_simple_unregister_notifier(struct drm_panel *panel, struct notifier_block *nb)
+{
+    struct panel_simple *p = container_of(panel, struct panel_simple, base);
+    return blocking_notifier_chain_unregister(&p->notifier_list, nb);
+}
+EXPORT_SYMBOL_GPL(panel_simple_unregister_notifier);
+
 static inline struct panel_simple *to_panel_simple(struct drm_panel *panel)
 {
 	return container_of(panel, struct panel_simple, base);
