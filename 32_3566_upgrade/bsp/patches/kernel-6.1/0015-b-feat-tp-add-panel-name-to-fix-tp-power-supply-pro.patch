+
+static int gtp_parse_panel(struct i2c_client *client, struct goodix_ts_data *ts)
+{
+    struct device_node *panel_np = NULL;
+    struct drm_panel *panel;
+    int ret;
+    const char *tmp_name;
+
+	ret = of_property_read_string(client->dev.of_node, "panel-name", &tmp_name);
+	if (ret) {
+		dev_err(&client->dev, "failed to read panel-name: %d\n", ret);
+		return -EINVAL;
+	}
+    strncpy(ts->panel_name, tmp_name, sizeof(ts->panel_name) - 1);
+	dev_info(&client->dev, "Touchscreen looking for panel: %s\n", ts->panel_name);
+
+    panel = drm_panel_get_by_name(ts->panel_name);
+
+    of_node_put(panel_np);
+
+    if (!panel) {
+        GTP_INFO("Panel device not ready, defer probe\n");
+        return -EPROBE_DEFER;
+    }
+
+    ts->panel = panel;
+    ts->nb.notifier_call = panel_notify_callback;
+    ret = panel_simple_register_notifier(ts->panel, &ts->nb);
+    if (ret) {
+        GTP_INFO("Failed to register panel notifier: %d\n", ret);
+        ts->panel = NULL;
+        return ret;
+    }
+
+    return 0;
+}
