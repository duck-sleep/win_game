+
+static int gtp_unregister_powermanger(struct goodix_ts_data *ts)
+{
+#if   defined(CONFIG_FB)
+		fb_unregister_client(&ts->notifier);
+		
+#elif defined(CONFIG_HAS_EARLYSUSPEND)
+		unregister_early_suspend(&ts->early_suspend);
+#endif
+	return 0;
+}
