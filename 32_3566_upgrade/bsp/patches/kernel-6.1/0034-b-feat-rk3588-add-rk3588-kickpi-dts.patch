+/dts-v1/;
+#include "rk3588s-kickpi-k8d.dtsi"
+
+/ {
+	model = "Rockchip RK3588S K8D Board";
+	compatible = "rockchip,rk3588s-k8d", "rockchip,rk3588";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-kickpi-k8d.dtsi b/arch/arm64/boot/dts/rockchip/rk3588s-kickpi-k8d.dtsi
