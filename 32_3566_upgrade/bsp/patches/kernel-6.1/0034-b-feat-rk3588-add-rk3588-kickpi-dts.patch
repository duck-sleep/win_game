+		default-state = "off";
+	};
+
+/*
+    gpio3b1 {
+        label = "gpio3b1";
+		gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+    gpio3b2 {
+        label = "gpio3b2";
+		gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+*/
+    gpio3b3 {
+        label = "gpio3b3";
+		gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+    gpio3b4 {
+        label = "gpio3b4";
+		gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
