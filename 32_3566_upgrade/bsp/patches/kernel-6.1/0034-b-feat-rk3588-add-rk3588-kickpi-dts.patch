diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-kickpi-k8d-gmac1.dtsi b/arch/arm64/boot/dts/rockchip/rk3588s-kickpi-k8d-gmac1.dtsi
new file mode 100755
index 0000000..1d70c26
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-kickpi-k8d-gmac1.dtsi
@@ -0,0 +1,27 @@
+&gmac1 {
+    phy-mode = "rgmii-rxid";
+    clock_in_out = "output";
+    snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
+    snps,reset-active-low;
+    /* Reset time is 20ms, 100ms for rtl8211f */
+    snps,reset-delays-us = <0 20000 100000>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&gmac1_miim
+                &gmac1_tx_bus2
+                &gmac1_rx_bus2
+                &gmac1_rgmii_clk
+                &gmac1_rgmii_bus>;
+
+    tx_delay = <0x45>;
+    /* rx_delay = <0x43>; */
+
+    phy-handle = <&rmii_phy>;
+    status = "okay";
+};
+
+&mdio1 {
+    rmii_phy: phy@1 {
+        compatible = "ethernet-phy-ieee802.3-c22";
+        reg = <0x0>;
+    };
+};
\ No newline at end of file
