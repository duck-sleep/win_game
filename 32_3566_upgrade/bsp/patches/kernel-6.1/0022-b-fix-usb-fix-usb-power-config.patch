From 03c3069f8db18c2fa67429ced93a4ca2403305b9 Mon Sep 17 00:00:00 2001
From: huangcm <cmhuang@kickpi.com>
Date: Fri, 10 Apr 2026 10:19:10 +0800
Subject: [PATCH 21/50] fix(usb): fix usb power config

Origin: kickpi be50592d02d4a94c71767b4df2a6686d57837239
---
 arch/arm64/boot/dts/rockchip/rk3566-kickpi-usb.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-kickpi-usb.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-usb.dtsi
index 72f3070..5d8d2f9 100755
--- a/arch/arm64/boot/dts/rockchip/rk3566-kickpi-usb.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-usb.dtsi
@@ -26,11 +26,11 @@ vcc5v0_otg: vcc5v0-otg-regulator {
 &pinctrl {
 	usb {
 		vcc5v0_host_en: vcc5v0-host-en {
-			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
 		};
 
 		vcc5v0_otg_en: vcc5v0-otg-en {
-			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
+			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
 		};
 	};
 };
