+};
+
+&usb2phy1 {
+	status = "okay";
+};
+
+&usb_host0_ehci {
+	status = "okay";
+};
+
+&usb_host0_ohci {
+	status = "okay";
+};
+
+// USB HOST3
+&u2phy1_host {
+	phy-supply = <&vcc5v0_host>;
+	status = "okay";
