diff --git a/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi
new file mode 100755
index 0000000..ecf5bfe
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-kickpi-camera.dtsi
@@ -0,0 +1,215 @@
+/ {
+
+	cam_ircut0: cam_ircut {
+		status = "okay";
+		compatible = "rockchip,ircut";
+		// ircut-open-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
+		// ircut-close-gpios  = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
+		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-facing = "back";
+	};
+
+	vcc_camera: vcc-camera-regulator {
+		compatible = "regulator-fixed";
+		gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&camera_pwr>;
+		regulator-name = "vcc_camera";
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	ext_cam_clk: external-camera0-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "ext_cam_clk";
+	};
+
+	ext_cam_25m_clk: external-camera-25m-clock {
+		compatible = "fixed-clock";
+		clock-frequency = <25000000>;
+		clock-output-names = "ext_cam_25m_clk";
+		#clock-cells = <0>;
+	};
+
+	ext_cam_37m_clk: external-camera-37m-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <37125000>;
+		clock-output-names = "ext_cam_37m_clk";
+	};
+
+};
+
+&pinctrl {
+	cam {
+		camera_pwr: camera-pwr {
+			rockchip,pins =
+				/* camera power en */
+				<4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+	};
+
+};
+
+&i2c2 {
+	status = "okay";
+    pinctrl-0 = <&i2c2m1_xfer>;
+
+	ov5647: ov5647@36 {
+		compatible = "ovti,ov5647";
+		status = "okay";
+		reg = <0x36>;
+		clocks = <&ext_cam_25m_clk>;
+		clock-names = "xvclk";
+
+		// pwdn-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		// power-domains = <&power RK3568_PD_VI>;
+		avdd-supply = <&vcc_camera>;
+
+		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-facing = "back";
+		rockchip,camera-module-name = "default";
+		rockchip,camera-module-lens-name = "default";
+		port {
+			ov5647_out: endpoint {
+				remote-endpoint = <&dphy0_in_ov5647>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+	
+	// 0c / 36
+   	ov13850: ov13850@36 {
+		compatible = "ovti,ov13850";
+		status = "okay";
+		reg = <0x36>;
+		clocks = <&ext_cam_clk>;
+		clock-names = "xvclk";
+		// dovdd-supply= <&cam_dovdd>; /* 1.8v */
+		avdd-supply = <&vcc_camera>;  /* 2.8v */
+		// dvdd-supply = <&cam_dvdd>;  /* 1.2v */
+		// rotation = <180>;
+
+		// pwdn-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		// reset-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
+
+		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-facing = "back";
+		rockchip,camera-module-name = "ZC-OV13850R2A-V1";
+		rockchip,camera-module-lens-name = "Largan-50064B31";
+
+		port {
+			/* MIPI CSI-2 bus endpoint */
+			ov13850_out: endpoint {
+				remote-endpoint = <&dphy0_in_ov13850>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+
+	imx415_0: imx415@37 {
+		compatible = "sony,imx415";
+		reg = <0x37>;
+		clocks = <&ext_cam_37m_clk>;
+		clock-names = "xvclk";
+		
+		power-domains = <&power RK3568_PD_VI>;
+		// avdd-supply = <&vcc_camera>;
+		
+		rockchip,camera-module-index = <0>;
+		rockchip,camera-module-facing = "back";
+		rockchip,camera-module-name = "CMK-OT1607-FV1";
+		rockchip,camera-module-lens-name = "M12-40IRC-4MP-F16";
+		lens-focus = <&cam_ircut0>;
+		port {
+			imx415_out0: endpoint {
+				remote-endpoint = <&mipi_in_ucam0>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+};
+
+&csi2_dphy0 {
+    status = "okay";
+
+    ports {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        port@0 {
+            reg = <0>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            mipi_in_ucam0: endpoint@1 {
+                reg = <1>;
+                remote-endpoint = <&imx415_out0>;
+                data-lanes = <1 2 3 4>;
+            };
+
+			dphy0_in_ov5647: endpoint@2 {
+				reg = <2>;
+				remote-endpoint = <&ov5647_out>;
+				data-lanes = <1 2>;
+			};
+
+			dphy0_in_ov13850: endpoint@3 {
+				reg = <3>;
+				remote-endpoint = <&ov13850_out>;
+				data-lanes = <1 2 3 4>;
+			};
+
+        };
+
+        port@1 {
+            reg = <1>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            csidphy_out: endpoint@1 {
+                reg = <1>;
+                remote-endpoint = <&isp0_in>;
+            };
+        };
+    };
+};
+
+&csi2_dphy_hw {
+    status = "okay";
+};
+
+&rkisp {
+	status = "okay";
+};
+
+&rkisp_mmu {
+	status = "okay";
+};
+
+&rkisp_vir0 {
+	status = "okay";
+
+	port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		isp0_in: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&csidphy_out>;
+		};
+	};
+};
+
+&rkcif {
+	status = "okay";
+};
+
+&rkcif_mmu {
+	status = "okay";
+};
