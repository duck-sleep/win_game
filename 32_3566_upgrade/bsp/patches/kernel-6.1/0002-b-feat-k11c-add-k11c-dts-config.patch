+
+&i2s2_2ch {
+    status = "okay";
+    pinctrl-names = "default";
+    pinctrl-0 = <&i2s2m0_sclktx
+            &i2s2m0_lrcktx
+            &i2s2m0_sdi
+            &i2s2m0_sdo>;
