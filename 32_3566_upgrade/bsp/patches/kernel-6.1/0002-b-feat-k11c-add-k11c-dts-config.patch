+&rk809_codec {
+	status = "disabled";
+};
+
+&i2s1_8ch {
+	status = "okay";
+	rockchip,clk-trcm = <1>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2s1m1_sclktx
+		&i2s1m1_lrcktx
+		&i2s1m1_mclk
+		&i2s1m1_sdi0>;
+};
+
+/ {
+	pcm1808_codec: pcm1808@0 {
+		compatible = "ti,pcm1808";
+		status = "okay";
+		#sound-dai-cells = <0>;
+	};
+
+	pcm1808_sound: pcm1808-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,name = "pcm1808";
+		status = "okay";
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1_8ch>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&pcm1808_codec>;
+		};
+
+	};
+};
