index 0000000..d6b2637
--- /dev/null
+++ b/scripts/build_multi_dtb.sh
@@ -0,0 +1,186 @@
+#!/bin/bash -e
+
+# Linux SDK 默认定义变量，device/rockchip/common/configs/Config.in.kernel
+# RK_KERNEL_DTS_DIR  DTS文件夹目录，例如:kernel/arch/arm64/boot/dts/rockchip
+# RK_KERNEL_DTS_NAME DTS文件名称，例如:rk3568-kickpi-k1-linux
+# RK_KERNEL_DTS      DTS文件目录，例如:kernel/arch/arm64/boot/dts/rockchip/rk3568-kickpi-k1-linux.dts
+# RK_KERNEL_DTB      DTS文件目录，例如:kernel/arch/arm64/boot/dts/rockchip/rk3568-kickpi-k1-linux.dtb
+
+CUR_PWD=`pwd`
+echo "cur_pwd: $CUR_PWD"
+
+KICKPI_DTS_DIR="$CUR_PWD/arch/arm64/boot/dts/rockchip"
+KICKPI_DTS_NAME=$RK_KERNEL_DTS_NAME
+KICKPI_DTS=$KICKPI_DTS_DIR/$KICKPI_DTS_NAME.dts
+
+# DTSI文件名称（自定义），例如：rk3568-kickpi-k1
+KICKPI_DTSI_NAME=`echo $KICKPI_DTS_NAME | rev | cut -d '-' -f 2- | rev`
+# DTSI文件目录（自定义），例如：kernel/arch/arm64/boot/dts/rockchip/rk3568-kickpi-k1.dtsi
+KICKPI_DTSI=$KICKPI_DTS_DIR/$KICKPI_DTSI_NAME.dtsi
+
+RUN_RET=0
+
+function null_line {
+	echo "Find Null Line In DTSI"
+	DTS_LINE=`grep -rn "kickpi-lcd" ${KICKPI_DTSI} | awk 'END {print}' | cut -d ":" -f 1`
+	NULL_LINE=`expr $DTS_LINE + 1`
+	STRING=`cat $KICKPI_DTSI | tail -n +$NULL_LINE | head -1`
+	echo -n $NULL_LINE
+	echo " is Null Line"
+	echo ""
+}
+
+
+function get_lcd_dtsi {
+	echo "Get Raw Data For LCD DTSI"
+	LCD_DTSI_NUM=0
+	IFS=$'\n'
+	for line in `grep -r "kickpi-lcd" $KICKPI_DTSI | sed 's/\///g'`
+	do
+		echo -n "LCD Num"
+		echo -n $LCD_DTSI_NUM
+		echo " Info"
+
+		# Raw Data,Such As: #include "rk3568-kickpi-lcd-mipi0-10.1-800-1280.dtsi"
+		echo $line
+
+        if [[ $line =~ "hdmi" || $line =~ "multi" ]]; then
+            echo "jump this LCD !"
+            continue
+        fi
+
+		LCD_DTSI_RAW_ARRAY[${LCD_DTSI_NUM}]=$line
+
+		# DTB File Name ,Such As: rk3568-kickpi-k1a-mipi0-10.1-800-1280
+		info=${line#*lcd-}
+		info=${info%.*}
+		DTS_NAME_ARRAY[${LCD_DTSI_NUM}]=${KICKPI_DTS_NAME}-${info}
+		echo ${DTS_NAME_ARRAY[${LCD_DTSI_NUM}]}
+
+		let LCD_DTSI_NUM=${LCD_DTSI_NUM}+1
+	done
+	unset IFS
+	echo ""
+}
+
+function build_multi_dtb {
+    echo '#define MULTI_NAME "hdmi"' > $MULTI_DTS_PATH
+    cpp -nostdinc -I $CUR_PWD/include -undef -x assembler-with-cpp ${KICKPI_DTS} > ${KICKPI_DTS_DIR}/.temp.dts
+    /usr/bin/dtc -I dts -O dtb -o ${KICKPI_DTS_DIR}/${KICKPI_DTS_NAME}-hdmi.dtb ${KICKPI_DTS_DIR}/.temp.dts
+
+    echo "*******************************************************************************************"
+    echo " RK_CHIP = $RK_CHIP "
+    echo "*******************************************************************************************"
+    if [[  $RK_CHIP =~ "rk3566" ]]; then
+        echo "*******************************************************************************************"
+        echo "      rk3566 only one vop remove hdmi ! "
+        echo "*******************************************************************************************"
+        sed -i '/kickpi-lcd-hdmi/ s/^/\/\//' $KICKPI_DTSI
+    fi
+
+	for((num=0;num<$LCD_DTSI_NUM;num++));
+	do
+        echo "build kickpi common ${KICKPI_DTS_DIR}/${DTS_NAME_ARRAY[$num]}.dtb"
+        echo "${LCD_DTSI_RAW_ARRAY[$num]}" > $MULTI_DTS_PATH
+		#sed -i -e "${NULL_LINE}s/.*$/${LCD_DTSI_RAW_ARRAY[$num]}/" $KICKPI_DTSI
+		cpp -nostdinc -I $CUR_PWD/include -undef -x assembler-with-cpp ${KICKPI_DTS} > ${KICKPI_DTS_DIR}/.temp.dts
+		/usr/bin/dtc -I dts -O dtb -o ${KICKPI_DTS_DIR}/${DTS_NAME_ARRAY[$num]}.dtb ${KICKPI_DTS_DIR}/.temp.dts
+        if [ $? -eq 0 ]; then
+            echo "Build ${DTS_NAME_ARRAY[$num]}.dtb ok!"
+        else
+            echo "Build ${DTS_NAME_ARRAY[$num]}.dtb failed!"
+            RUN_RET=1
+            return
+        fi
+	done
+
+    echo "*******************************************************************************************"
+    echo "      build multi dtb success ! "
+    echo "*******************************************************************************************"
+    if [[  $RK_CHIP =~ "rk3588" && $RK_CHIP != *"rk3588s"* ]]; then
+        build_multi_dtb_rk3588
+    fi
+}
+
+function build_multi_dtb_rk3588 {
+
+    txt_file="k8_lcd_multi.txt"
+    input_file=${KICKPI_DTS_DIR}/$txt_file
+
+    if [ ! -f "$input_file" ]; then
+        echo "can't find $input_file !!"
+        RUN_RET=1
+        return
+    fi
+
+    target_name=""
+    build_target=""
+    while IFS= read -r line; do
+        if [[ $line =~ ^\[([^\]]+)\]$ ]]; then
+            build_target=$target_name
+            target_name="${BASH_REMATCH[1]}"
+            if [ -n "$build_target" ]; then
+                echo "build kickpi $build_target.dtb"
+                cpp -nostdinc -I ./kernel/include -undef -x assembler-with-cpp ${KICKPI_DTS} > ${KICKPI_DTS_DIR}/.temp.dts
+                /usr/bin/dtc -I dts -O dtb -o ${KICKPI_DTS_DIR}/${KICKPI_DTS_NAME}-$build_target.dtb ${KICKPI_DTS_DIR}/.temp.dts
+                if [ $? -eq 0 ]; then
+                    echo "Build ${KICKPI_DTS_NAME}-$build_target.dtb ok!"
+                else
+                    echo "Build ${KICKPI_DTS_NAME}-$build_target.dtb failed!"
+                    RUN_RET=1
+                    return
+                fi
+            else
+                echo "" > $MULTI_DTS_PATH
+            fi
+        elif [[ -n $target_name ]]; then
+            if [[ $line =~ \.dtsi$ ]]; then
+                if [ -f $KICKPI_DTS_DIR/$line ] ; then
+                    echo "#include \"$line\"" >> $MULTI_DTS_PATH
+                else
+                    echo "can't find $KICKPI_DTSI/$line !"
+                fi
+            fi
+        fi
+    done < "$input_file"
+
+    echo "*******************************************************************************************"
+    echo "      build multi rk3588 dtb success ! "
+    echo "*******************************************************************************************"
+}
+
+function build_resource_img {
+	./scripts/mkmultidtb.py ${KICKPI_DTS_NAME}
+	cp resource.img resource_multi_dtb.img
+}
+
+function modify_common {
+    # rm -vf ${KICKPI_DTS_DIR}/*.dtb
+
+    sed -i '/kickpi-lcd/ s/^/\/\//' $KICKPI_DTSI
+    sed -i '/kickpi-lcd-hdmi/ s,^//,,' $KICKPI_DTSI
+    if [[ $KICKPI_DTS =~ "rk3588" ]]; then
+        sed -i '/kickpi-lcd-dp/ s,^//,,' $KICKPI_DTSI
+    fi
+
+    echo "" >> $KICKPI_DTSI
+    echo '#include "kickpi-lcd-multi.dtsi"' >> $KICKPI_DTSI
+
+    MULTI_DTS_PATH=${KICKPI_DTS_DIR}/kickpi-lcd-multi.dtsi
+    echo '#define MULTI_NAME "null"' > $MULTI_DTS_PATH
+}
+
+function recover_common {
+    sed -i '/kickpi-lcd/ s,^//,,' $KICKPI_DTSI
+    sed -i '$d' $KICKPI_DTSI
+    sed -i '$d' $KICKPI_DTSI
+    rm $MULTI_DTS_PATH
+}
+
+#null_line
+modify_common
+get_lcd_dtsi
+build_multi_dtb
+build_resource_img
+recover_common
+exit $RUN_RET
