Origin: kickpi ced31a6ee3bab8b5688e294bbe3ae7ad7124ab1e
---
 configs/rockchip/base/common.config | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/rockchip/base/common.config b/configs/rockchip/base/common.config
index 4ff2bb3..dc7780f 100644
--- a/configs/rockchip/base/common.config
+++ b/configs/rockchip/base/common.config
@@ -11,7 +11,7 @@ BR2_PRIMARY_SITE="https://sources.buildroot.net"
 BR2_BACKUP_SITE=""
 
 # Mirror for GNU packages
-BR2_GNU_MIRROR="https://mirrors.ustc.edu.cn/gnu"
