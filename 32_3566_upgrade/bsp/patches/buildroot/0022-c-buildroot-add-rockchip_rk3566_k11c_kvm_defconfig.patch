From: bsp-split <bsp-split@local>
Date: Thu, 19 Nov 2026 11:12:28 -0500
Subject: [PATCH 1/2] buildroot: add rockchip_rk3566_k11c_kvm_defconfig

Origin: 32_3566_upgrade/sdk/buildroot/configs/rockchip_rk3566_k11c_kvm_defconfig
---
 configs/rockchip_rk3566_k11c_kvm_defconfig | 34 ++++++++++++++++++++++
 1 file changed, 34 insertions(+)
 create mode 100644 buildroot/configs/rockchip_rk3566_k11c_kvm_defconfig

diff --git a/configs/rockchip_rk3566_k11c_kvm_defconfig b/configs/rockchip_rk3566_k11c_kvm_defconfig
new file mode 100644
index 000000000..3f4634cb4
--- /dev/null
+++ b/configs/rockchip_rk3566_k11c_kvm_defconfig
@@ -0,0 +1,34 @@
+#include "base/base.config"
+#include "chips/rk3566_rk3568_aarch64.config"
+#include "fs/vfat.config"
+#include "fs/exfat.config"
+#include "multimedia/mpp.config"
+#include "wifibt/wireless.config"
+
+# systemd, so the Ubuntu service files can be copied as-is
+BR2_INIT_SYSTEMD=y
+
+# JetKVM runtime
+BR2_PACKAGE_PYTHON3=y
+BR2_PACKAGE_LIBDRM=y
+BR2_PACKAGE_GSTREAMER1=y
+BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
+BR2_PACKAGE_GST1_PLUGINS_BASE=y
+BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP=y
+BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_UDP=y
+BR2_PACKAGE_GST1_PLUGINS_BAD=y
+BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
+BR2_PACKAGE_GSTREAMER1_ROCKCHIP=y
+
+# upgrade tool on the main system
+BR2_PACKAGE_RKTOOLKIT=y
+
+# kickpi.local
+BR2_PACKAGE_AVAHI=y
+BR2_PACKAGE_AVAHI_DAEMON=y
+
+# our files and the kickpi user
+BR2_ROOTFS_OVERLAY+="/home/rk/k11c/k11c-br-overlay"
+BR2_ROOTFS_USERS_TABLES="/home/rk/k11c/k11c-br-users.txt"
