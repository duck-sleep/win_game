[Unit]
Description=K11C JetKVM cloud client
After=network.target k11c-fakevo.service

[Service]
Type=simple
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/opt/k11c-kvm/k11c-cloud -state /etc/k11c/cloud.json -rtp 127.0.0.1:5005
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
